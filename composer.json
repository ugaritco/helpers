{
    "name": "ugarit/helpers",
    "description": "Provides backwards compatibility for helpers in the latest Ugarit release.",
    "keywords": [
        "ugarit",
        "helpers"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        },
        {
            "name": "Dries Vints",
            "email": "dries@ugarit.com"
        }
    ],
    "require": {
        "php": "^7.2.0|^8.0",
        "heritage/support": "^1.00.00"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    },
    "config": {
        "audit": {
            "block-insecure": false
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "1.00.00"
}
